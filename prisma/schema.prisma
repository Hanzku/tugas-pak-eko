generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String       @id @default(uuid())
  nama              String
  email             String       @unique
  password          String
  role              String       @default("SISWA") // PENGAJAR | SISWA
  createdAt         DateTime     @default(now())
  kelas             Kelas[]
  kelasDiikuti      Kelas[]      @relation("KelasSiswa")
  submissions       Submission[]
  gradedSubmissions Submission[] @relation("GradedBy")
}

model Kelas {
  id            String       @id @default(uuid())
  nama          String
  deskripsi     String?
  mataPelajaran String
  tahunAjaran   String
  kode          String       @unique
  pengajarId    String
  pengajar      User         @relation(fields: [pengajarId], references: [id])
  siswa         User[]       @relation("KelasSiswa")
  createdAt     DateTime     @default(now())
  materi        Materi[]
  gambar        Gambar[]
  tugas         Tugas[]
  pengumuman    Pengumuman[]
}

model Materi {
  id        String  @id @default(uuid())
  judul     String
  deskripsi String?
  fileUrl   String
  fileName  String
  fileSize  Int
  fileType  String
  kelasId   String
  kelas     Kelas   @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Submission {
  id           String    @id @default(uuid())
  assignmentId String
  assignment   Tugas     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileUrl      String
  fileName     String
  fileSize     Int       @default(0)
  submittedAt  DateTime  @default(now())
  status       String    @default("DIKUMPULKAN") // DIKUMPULKAN | TERLAMBAT | DINILAI
  score        Int?
  feedback     String?
  gradedAt     DateTime?
  gradedById   String?
  gradedBy     User?     @relation("GradedBy", fields: [gradedById], references: [id])

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}

model Gambar {
  id        String   @id @default(uuid())
  judul     String
  deskripsi String?
  imageUrl  String
  fileName  String
  fileSize  Int
  kelasId   String
  kelas     Kelas    @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Tugas {
  id          String       @id @default(uuid())
  judul       String
  deskripsi   String
  deadline    DateTime?
  fileUrl     String?
  fileName    String?
  kelasId     String
  kelas       Kelas        @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  submissions Submission[]
}

model Pengumuman {
  id        String   @id @default(uuid())
  judul     String
  isi       String
  penting   Boolean  @default(false)
  kelasId   String
  kelas     Kelas    @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
